rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default: Deny all access unless explicitly granted below
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Optional hardening. Set to true to require a verified email for the super-admin bootstrap.
    function requireVerifiedEmail() { return false; }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email != null &&
        (request.auth.token.email.lower() == 'unfeohaluaghat@gmail.com' ||
         request.auth.token.email.lower() == 'absiddik5177@gmail.com') &&
        (!requireVerifiedEmail() || request.auth.token.email_verified == true);
    }

    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveMember() {
      return hasUserDoc() && getUserDoc().status == 'Active';
    }

    function canRead() {
      return isSuperAdmin() || isActiveMember();
    }

    function isCourseDirector() {
      return isSuperAdmin() || (
        hasUserDoc() &&
        getUserDoc().role == 'Course Director' &&
        getUserDoc().status == 'Active'
      );
    }

    function isFMA() {
      return hasUserDoc() &&
             getUserDoc().role == 'FMA' &&
             getUserDoc().status == 'Active';
    }

    function isTrainer() {
      return hasUserDoc() &&
             getUserDoc().role == 'Trainer' &&
             getUserDoc().status == 'Active';
    }

    function getUserBatchId() {
      return getUserDoc().batchId;
    }

    function isAdoptingPreCreatedUser(userId) {
      return request.auth.uid == userId &&
        request.auth.token.email != null &&
        'adoptedFromId' in request.resource.data &&
        request.resource.data.adoptedFromId is string &&
        isValidId(request.resource.data.adoptedFromId) &&
        request.resource.data.adoptedFromId != userId &&
        exists(/databases/$(database)/documents/users/$(request.resource.data.adoptedFromId)) &&
        get(/databases/$(database)/documents/users/$(request.resource.data.adoptedFromId)).data.email != null &&
        get(/databases/$(database)/documents/users/$(request.resource.data.adoptedFromId)).data.email.lower() == request.auth.token.email.lower() &&
        get(/databases/$(database)/documents/users/$(request.resource.data.adoptedFromId)).data.status in ['Active', 'Pending Approval'] &&
        request.resource.data.id == userId &&
        request.resource.data.email != null &&
        request.resource.data.email.lower() == request.auth.token.email.lower() &&
        request.resource.data.role == get(/databases/$(database)/documents/users/$(request.resource.data.adoptedFromId)).data.role &&
        request.resource.data.status == get(/databases/$(database)/documents/users/$(request.resource.data.adoptedFromId)).data.status &&
        !existsAfter(/databases/$(database)/documents/users/$(request.resource.data.adoptedFromId));
    }

    // --- 1. User Profiles & RBAC ---
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isCourseDirector() || isFMA());
      allow list: if isSignedIn() && (
        isCourseDirector() || 
        isFMA() || 
        resource.data.id == request.auth.uid ||
        (request.auth.token.email != null && resource.data.email != null &&
          (resource.data.email == request.auth.token.email ||
           resource.data.email == request.auth.token.email.lower()))
      );

      allow create: if isSignedIn() && isValidId(userId) && (
        (
          request.auth.uid == userId && (
            isSuperAdmin() ||
            isAdoptingPreCreatedUser(userId) ||
            (
              request.resource.data.role == 'Pending' &&
              request.resource.data.status == 'Pending Approval' &&
              (request.auth.token.email == null ||
                (request.resource.data.email != null &&
                 request.resource.data.email.lower() == request.auth.token.email.lower()))
            )
          )
        ) ||
        isCourseDirector()
      );

      allow update: if isSignedIn() && isValidId(userId) && (
        isCourseDirector() ||
        (
          request.auth.uid == userId &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.status == resource.data.status &&
          request.resource.data.id == resource.data.id &&
          request.resource.data.email == resource.data.email &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notificationsSeenAt', 'notificationsClearedAt']) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['notificationsSeenAt']) || request.resource.data.notificationsSeenAt is timestamp) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['notificationsClearedAt']) || request.resource.data.notificationsClearedAt is timestamp)
        )
      );

      allow delete: if isSignedIn() && (
        (isCourseDirector() && request.auth.uid != userId) ||
        (resource.data.email != null && request.auth.token.email != null && resource.data.email.lower() == request.auth.token.email.lower())
      );
    }

    // --- 2. Institutes & Centers ---
    match /institutes/{instituteId} {
      allow get: if canRead() && isValidId(instituteId);
      allow list: if canRead();
      allow write: if isCourseDirector() && isValidId(instituteId);
    }

    // --- 3. Vocational Trades ---
    match /trades/{tradeId} {
      allow get: if canRead() && isValidId(tradeId);
      allow list: if canRead();
      allow write: if isCourseDirector() && isValidId(tradeId);
    }

    // --- 4. Training Batches ---
    match /batches/{batchId} {
      allow get: if canRead() && isValidId(batchId);
      allow list: if canRead();
      allow create, delete: if isCourseDirector() && isValidId(batchId);
      allow update: if isValidId(batchId) && (
        isCourseDirector() ||
        (isTrainer() && getUserBatchId() == batchId)
      );
    }

    // --- 5. Trainees ---
    match /trainees/{traineeId} {
      allow get: if canRead() && isValidId(traineeId);
      allow list: if canRead();
      allow create: if isValidId(traineeId) && (
        isCourseDirector() ||
        (isTrainer() && request.resource.data.batchId == getUserBatchId())
      );
      allow update: if isValidId(traineeId) && (
        isCourseDirector() ||
        (isTrainer() && resource.data.batchId == getUserBatchId())
      );
      allow delete: if isCourseDirector() && isValidId(traineeId);
    }

    // --- 6. Daily Attendance ---
    match /attendance/{attendanceId} {
      allow get: if canRead() && isValidId(attendanceId);
      allow list: if canRead();
      allow create: if isValidId(attendanceId) && (
        isCourseDirector() ||
        (isTrainer() && request.resource.data.batchId == getUserBatchId())
      );
      allow update: if isValidId(attendanceId) && (
        isCourseDirector() ||
        (isTrainer() && resource.data.batchId == getUserBatchId())
      );
      allow delete: if isCourseDirector() && isValidId(attendanceId);
    }

    // --- 7. Exams & Assessments ---
    match /exams/{examId} {
      allow get: if canRead() && isValidId(examId);
      allow list: if canRead();
      allow create, update: if isValidId(examId) && (isCourseDirector() || isTrainer());
      allow delete: if isCourseDirector() && isValidId(examId);
    }

    // --- 8. Exam Marks ---
    match /marks/{markId} {
      allow get: if canRead() && isValidId(markId);
      allow list: if canRead();
      allow create, update: if isValidId(markId) && (isCourseDirector() || isTrainer());
      allow delete: if isCourseDirector() && isValidId(markId);
    }

    // --- 9. RBAC Roles ---
    match /roles/{roleId} {
      allow get: if canRead() && isValidId(roleId);
      allow list: if canRead();
      allow write: if isCourseDirector() && isValidId(roleId);
    }

    // --- 10. Audit Activity Logs (Append-Only + One-Time Undo/Restore Mark + Chunked Snapshots) ---
    function isValidAuditLocation(loc) {
      return loc is map &&
             loc.keys().hasAll(['status', 'capturedAt', 'source']) &&
             loc.keys().hasOnly(['status', 'lat', 'lng', 'accuracy', 'capturedAt', 'source']) &&
             loc.status in ['granted', 'denied', 'unavailable', 'timeout', 'unsupported'] &&
             loc.source in ['native', 'web'] &&
             loc.capturedAt is string &&
             loc.capturedAt.size() >= 10 &&
             loc.capturedAt.size() <= 40 &&
             (
               (loc.status == 'granted' && 'lat' in loc && 'lng' in loc) ||
               (loc.status != 'granted' && loc.keys().hasOnly(['status', 'capturedAt', 'source']))
             ) &&
             (!('lat' in loc) || ((loc.lat is int || loc.lat is float) && loc.lat >= -90 && loc.lat <= 90)) &&
             (!('lng' in loc) || ((loc.lng is int || loc.lng is float) && loc.lng >= -180 && loc.lng <= 180)) &&
             (!('accuracy' in loc) || ((loc.accuracy is int || loc.accuracy is float) && loc.accuracy >= 0));
    }

    function isActiveUserDoc() {
      return hasUserDoc() && getUserDoc().status == 'Active';
    }

    function isAuditNotificationRecipient() {
      return isActiveUserDoc() && (
        (getUserDoc().role in resource.data.notifyRoles) ||
        (request.auth.uid in resource.data.notifyUserIds)
      );
    }

    match /activityLogs/{logId} {
      allow get: if isValidId(logId) && (
        isCourseDirector() ||
        isAuditNotificationRecipient() ||
        (isActiveUserDoc() && resource.data.userId == request.auth.uid)
      );
      allow list: if isCourseDirector() || isAuditNotificationRecipient();
      allow create: if isSignedIn() &&
                       isValidId(logId) &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.notifyRoles is list &&
                       request.resource.data.notifyUserIds is list &&
                       request.resource.data.priority in ['normal', 'warning', 'urgent'] &&
                       (!('reverted' in request.resource.data) || request.resource.data.reverted == false) &&
                       (!('settled' in request.resource.data) || request.resource.data.settled == false) &&
                       (!('location' in request.resource.data) || isValidAuditLocation(request.resource.data.location));
      allow update: if (
        isCourseDirector() &&
        isValidId(logId) &&
        (!('reverted' in resource.data) || resource.data.reverted == false) &&
        (!('settled' in resource.data) || resource.data.settled == false) && (
          (
            request.resource.data.reverted == true &&
            request.resource.data.revertedBy is string &&
            request.resource.data.revertedBy.size() > 0 &&
            request.resource.data.revertedBy.size() <= 150 &&
            request.resource.data.revertedAt is timestamp &&
            request.resource.data.keys().hasAll(['reverted', 'revertedBy', 'revertedAt']) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reverted', 'revertedBy', 'revertedAt'])
          ) ||
          (
            request.resource.data.settled == true &&
            request.resource.data.settledBy == request.auth.uid &&
            request.resource.data.settledByName is string &&
            request.resource.data.settledByName.size() > 0 &&
            request.resource.data.settledByName.size() <= 150 &&
            request.resource.data.settledAt is timestamp &&
            (
              request.resource.data.settleNote == null ||
              (request.resource.data.settleNote is string && request.resource.data.settleNote.size() <= 500)
            ) &&
            request.resource.data.keys().hasAll(['settled', 'settledBy', 'settledByName', 'settledAt', 'settleNote']) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['settled', 'settledBy', 'settledByName', 'settledAt', 'settleNote'])
          )
        )
      ) || (
        isActiveUserDoc() &&
        isValidId(logId) &&
        logId.matches('^att_.+_[0-9]{8}$') &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId &&
        resource.data.module == 'attendance' &&
        request.resource.data.module == 'attendance' &&
        (!('reverted' in resource.data) || resource.data.reverted == false) &&
        (!('settled' in resource.data) || resource.data.settled == false) &&
        request.resource.data.reverted == resource.data.reverted &&
        request.resource.data.settled == resource.data.settled &&
        request.resource.data.notifyRoles is list &&
        request.resource.data.notifyUserIds is list &&
        request.resource.data.priority in ['normal', 'warning', 'urgent'] &&
        (!('location' in request.resource.data) || isValidAuditLocation(request.resource.data.location))
      );
      allow delete: if false; // Never delete audit logs

      match /snapshots/{chunkId} {
        allow get, list: if isCourseDirector() && isValidId(logId) && isValidId(chunkId);
        allow create: if isSignedIn() &&
                         isValidId(logId) &&
                         isValidId(chunkId) &&
                         request.resource.data.userId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // --- 11. System Settings ---
    match /settings/{settingId} {
      allow get: if canRead() && isValidId(settingId);
      allow list: if canRead();
      allow write: if isCourseDirector() && isValidId(settingId);
    }

    match /systemSettings/{settingId} {
      allow get: if canRead() && isValidId(settingId);
      allow list: if canRead();
      allow write: if isCourseDirector() && isValidId(settingId);
    }

    // --- 12. Shikhon Calendar Modules ---
    match /trade_skill_modules/{moduleId} {
      allow get: if canRead() && isValidId(moduleId);
      allow list: if canRead();
      allow write: if isCourseDirector() && isValidId(moduleId);
    }

    match /trade_literacy_modules/{moduleId} {
      allow get: if canRead() && isValidId(moduleId);
      allow list: if canRead();
      allow write: if isCourseDirector() && isValidId(moduleId);
    }

    // --- 13. Batch Calendar Progress ---
    match /batch_calendar_progress/{progressId} {
      allow get: if canRead() && isValidId(progressId);
      allow list: if canRead();
      allow create, update: if isValidId(progressId) && (
        isCourseDirector() ||
        (isTrainer() && (request.resource.data.batchId == getUserBatchId() || resource.data.batchId == getUserBatchId()))
      );
      allow delete: if isCourseDirector() && isValidId(progressId);
    }

    match /calendar_progress_logs/{logId} {
      allow get: if canRead() && isValidId(logId);
      allow list: if canRead();
      allow create, update: if isValidId(logId) && (
        isCourseDirector() ||
        (isTrainer() && (request.resource.data.batchId == getUserBatchId() || resource.data.batchId == getUserBatchId()))
      );
      allow delete: if isCourseDirector() && isValidId(logId);
    }

    // --- 14. Legacy unused notifications collection (locked; audit logs power notifications) ---
    match /notifications/{notifId} {
      allow read, write: if false;
    }
  }
}
