rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default: Deny all access unless explicitly granted below
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Recognized Bootstrapped Course Director Emails
    function isSuperAdmin() {
      return isSignedIn() &&
             request.auth.token.email != null &&
             (
               request.auth.token.email.lower() == 'unfeohaluaghat@gmail.com' ||
               request.auth.token.email.lower() == 'absiddik5177@gmail.com'
             );
    }

    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isCourseDirector() {
      return isSuperAdmin() || (
        hasUserDoc() &&
        getUserDoc().role == 'Course Director' &&
        getUserDoc().status == 'Active'
      );
    }

    function isFMA() {
      return hasUserDoc() &&
             getUserDoc().role == 'FMA' &&
             getUserDoc().status == 'Active';
    }

    function isTrainer() {
      return hasUserDoc() &&
             getUserDoc().role == 'Trainer' &&
             getUserDoc().status == 'Active';
    }

    function getUserBatchId() {
      return getUserDoc().batchId;
    }

    // --- 1. User Profiles & RBAC ---
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isCourseDirector() || isFMA());
      allow list: if isSignedIn() && (
        isCourseDirector() || 
        isFMA() || 
        resource.data.id == request.auth.uid ||
        (request.auth.token.email != null && resource.data.email != null && resource.data.email.lower() == request.auth.token.email.lower())
      );

      allow create: if isSignedIn() && isValidId(userId) && (
        isCourseDirector() ||
        (
          request.auth.uid == userId && (
            isSuperAdmin() ||
            (
              request.resource.data.role == 'Pending' &&
              request.resource.data.status == 'Pending Approval'
            )
          )
        )
      );

      allow update: if isSignedIn() && isValidId(userId) && (
        isCourseDirector() ||
        (
          request.auth.uid == userId &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.status == resource.data.status &&
          request.resource.data.id == resource.data.id &&
          request.resource.data.email == resource.data.email
        )
      );

      allow delete: if isSignedIn() && (
        (isCourseDirector() && request.auth.uid != userId) ||
        (resource.data.email != null && request.auth.token.email != null && resource.data.email.lower() == request.auth.token.email.lower())
      );
    }

    // --- 2. Institutes & Centers ---
    match /institutes/{instituteId} {
      allow get: if isSignedIn() && isValidId(instituteId);
      allow list: if isSignedIn();
      allow write: if isCourseDirector() && isValidId(instituteId);
    }

    // --- 3. Vocational Trades ---
    match /trades/{tradeId} {
      allow get: if isSignedIn() && isValidId(tradeId);
      allow list: if isSignedIn();
      allow write: if isCourseDirector() && isValidId(tradeId);
    }

    // --- 4. Training Batches ---
    match /batches/{batchId} {
      allow get: if isSignedIn() && isValidId(batchId);
      allow list: if isSignedIn();
      allow create, delete: if isCourseDirector() && isValidId(batchId);
      allow update: if isValidId(batchId) && (
        isCourseDirector() ||
        (isTrainer() && getUserBatchId() == batchId)
      );
    }

    // --- 5. Trainees ---
    match /trainees/{traineeId} {
      allow get: if isSignedIn() && isValidId(traineeId);
      allow list: if isSignedIn();
      allow create: if isValidId(traineeId) && (
        isCourseDirector() ||
        (isTrainer() && request.resource.data.batchId == getUserBatchId())
      );
      allow update: if isValidId(traineeId) && (
        isCourseDirector() ||
        (isTrainer() && resource.data.batchId == getUserBatchId())
      );
      allow delete: if isCourseDirector() && isValidId(traineeId);
    }

    // --- 6. Daily Attendance ---
    match /attendance/{attendanceId} {
      allow get: if isSignedIn() && isValidId(attendanceId);
      allow list: if isSignedIn();
      allow create: if isValidId(attendanceId) && (
        isCourseDirector() ||
        (isTrainer() && request.resource.data.batchId == getUserBatchId())
      );
      allow update: if isValidId(attendanceId) && (
        isCourseDirector() ||
        (isTrainer() && resource.data.batchId == getUserBatchId())
      );
      allow delete: if isCourseDirector() && isValidId(attendanceId);
    }

    // --- 7. Exams & Assessments ---
    match /exams/{examId} {
      allow get: if isSignedIn() && isValidId(examId);
      allow list: if isSignedIn();
      allow create, update: if isValidId(examId) && (isCourseDirector() || isTrainer());
      allow delete: if isCourseDirector() && isValidId(examId);
    }

    // --- 8. Exam Marks ---
    match /marks/{markId} {
      allow get: if isSignedIn() && isValidId(markId);
      allow list: if isSignedIn();
      allow create, update: if isValidId(markId) && (isCourseDirector() || isTrainer());
      allow delete: if isCourseDirector() && isValidId(markId);
    }

    // --- 9. RBAC Roles ---
    match /roles/{roleId} {
      allow get: if isSignedIn() && isValidId(roleId);
      allow list: if isSignedIn();
      allow write: if isCourseDirector() && isValidId(roleId);
    }

    // --- 10. Audit Activity Logs (Append-Only + One-Time Undo/Restore Mark + Chunked Snapshots) ---
    function isValidAuditLocation(loc) {
      return loc is map &&
             loc.keys().hasAll(['status', 'capturedAt', 'source']) &&
             loc.keys().hasOnly(['status', 'lat', 'lng', 'accuracy', 'capturedAt', 'source']) &&
             loc.status in ['granted', 'denied', 'unavailable', 'timeout', 'unsupported'] &&
             loc.source in ['native', 'web'] &&
             loc.capturedAt is string &&
             loc.capturedAt.size() >= 10 &&
             loc.capturedAt.size() <= 40 &&
             (
               (loc.status == 'granted' && 'lat' in loc && 'lng' in loc) ||
               (loc.status != 'granted' && loc.keys().hasOnly(['status', 'capturedAt', 'source']))
             ) &&
             (!('lat' in loc) || ((loc.lat is int || loc.lat is float) && loc.lat >= -90 && loc.lat <= 90)) &&
             (!('lng' in loc) || ((loc.lng is int || loc.lng is float) && loc.lng >= -180 && loc.lng <= 180)) &&
             (!('accuracy' in loc) || ((loc.accuracy is int || loc.accuracy is float) && loc.accuracy >= 0));
    }

    match /activityLogs/{logId} {
      allow get: if isCourseDirector() && isValidId(logId);
      allow list: if isCourseDirector();
      allow create: if isSignedIn() &&
                       isValidId(logId) &&
                       request.resource.data.userId == request.auth.uid &&
                       (!('reverted' in request.resource.data) || request.resource.data.reverted == false) &&
                       (!('settled' in request.resource.data) || request.resource.data.settled == false) &&
                       (!('location' in request.resource.data) || isValidAuditLocation(request.resource.data.location));
      allow update: if isCourseDirector() &&
                       isValidId(logId) &&
                       (!('reverted' in resource.data) || resource.data.reverted == false) &&
                       (!('settled' in resource.data) || resource.data.settled == false) && (
                         (
                           request.resource.data.reverted == true &&
                           request.resource.data.revertedBy is string &&
                           request.resource.data.revertedBy.size() > 0 &&
                           request.resource.data.revertedBy.size() <= 150 &&
                           request.resource.data.revertedAt is timestamp &&
                           request.resource.data.keys().hasAll(['reverted', 'revertedBy', 'revertedAt']) &&
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reverted', 'revertedBy', 'revertedAt'])
                         ) ||
                         (
                           request.resource.data.settled == true &&
                           request.resource.data.settledBy == request.auth.uid &&
                           request.resource.data.settledByName is string &&
                           request.resource.data.settledByName.size() > 0 &&
                           request.resource.data.settledByName.size() <= 150 &&
                           request.resource.data.settledAt is timestamp &&
                           (
                             request.resource.data.settleNote == null ||
                             (request.resource.data.settleNote is string && request.resource.data.settleNote.size() <= 500)
                           ) &&
                           request.resource.data.keys().hasAll(['settled', 'settledBy', 'settledByName', 'settledAt', 'settleNote']) &&
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['settled', 'settledBy', 'settledByName', 'settledAt', 'settleNote'])
                         )
                       );
      allow delete: if false; // Never delete audit logs

      match /snapshots/{chunkId} {
        allow get, list: if isCourseDirector() && isValidId(logId) && isValidId(chunkId);
        allow create: if isSignedIn() &&
                         isValidId(logId) &&
                         isValidId(chunkId) &&
                         request.resource.data.userId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // --- 11. System Settings ---
    match /settings/{settingId} {
      allow get: if isSignedIn() && isValidId(settingId);
      allow list: if isSignedIn();
      allow write: if isCourseDirector() && isValidId(settingId);
    }

    match /systemSettings/{settingId} {
      allow get: if isSignedIn() && isValidId(settingId);
      allow list: if isSignedIn();
      allow write: if isCourseDirector() && isValidId(settingId);
    }

    // --- 12. Shikhon Calendar Modules ---
    match /trade_skill_modules/{moduleId} {
      allow get: if isSignedIn() && isValidId(moduleId);
      allow list: if isSignedIn();
      allow write: if isCourseDirector() && isValidId(moduleId);
    }

    match /trade_literacy_modules/{moduleId} {
      allow get: if isSignedIn() && isValidId(moduleId);
      allow list: if isSignedIn();
      allow write: if isCourseDirector() && isValidId(moduleId);
    }

    // --- 13. Batch Calendar Progress ---
    match /batch_calendar_progress/{progressId} {
      allow get: if isSignedIn() && isValidId(progressId);
      allow list: if isSignedIn();
      allow create, update: if isValidId(progressId) && (
        isCourseDirector() ||
        (isTrainer() && (request.resource.data.batchId == getUserBatchId() || resource.data.batchId == getUserBatchId()))
      );
      allow delete: if isCourseDirector() && isValidId(progressId);
    }

    match /calendar_progress_logs/{logId} {
      allow get: if isSignedIn() && isValidId(logId);
      allow list: if isSignedIn();
      allow create, update: if isValidId(logId) && (
        isCourseDirector() ||
        (isTrainer() && (request.resource.data.batchId == getUserBatchId() || resource.data.batchId == getUserBatchId()))
      );
      allow delete: if isCourseDirector() && isValidId(logId);
    }

    // --- 14. In-App Notifications ---
    match /notifications/{notifId} {
      allow get: if isSignedIn() && isValidId(notifId);
      allow list: if isSignedIn();
      allow write: if isSignedIn() && isValidId(notifId);
    }
  }
}
